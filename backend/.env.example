# REelo runtime configuration
REELO_ENV=development
REELO_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173

# Rate limiting
REELO_RATE_LIMIT_PER_MINUTE=120
REELO_RATE_WINDOW_SECONDS=60
REELO_RATE_LIMIT=120

# Optional production infrastructure
REELO_REDIS_URL=
REELO_OBJECT_STORAGE_BUCKET=
REELO_CDN_BASE_URL=

# Optional integrations
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
